- id: web-search-deepseek # magpie
  name: "@deepseek-ai/dsh-web-search-deepseek"
  config:
    apiKeyEnv: MAGPIE_GATEWAY_KEY
    # magpie: points at magpie's local gateway; Disconnect in magpie or `magpie uninstall` undoes it, or remove this entry and pick another model
    baseURL: "http://127.0.0.1:3425/v1"
    model: "workbuddy-ai/deepseek-v4.1-flash-sg"
- id: subagent-model-selection-settings
  name: "@deepseek-ai/dsh-tool-subagent/model-selection-settings"
  config:
    enabled: true
    allowedModels:
      - provider: magpie
        model: codearts/glm-5.3-flash
      - provider: magpie
        model: codearts/deepseek-v4.1-flash
      - provider: magpie
        model: codearts/kimi-k3.1-pro
      - provider: magpie
        model: codearts/glm-5.3
      - provider: magpie
        model: autoclaw-cn/zaicoding_glm-5.3
      - provider: magpie
        model: autoclaw-cn/zai_glm-5.3-flash
      - provider: magpie
        model: officeace/kimi-k3
      - provider: magpie
        model: officeace/deepseek-v4.1-flash
      - provider: magpie
        model: officeace/kimi-k3.1-pro-highspeed
