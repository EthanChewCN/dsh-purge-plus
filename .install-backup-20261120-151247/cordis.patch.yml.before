# Your patch layer for this dsh profile, applied after every bundle layer:
# a top-level YAML array of loader patch entries (id-targeted config
# overrides, disables, and insert lists; `!!js` expressions allowed).
- id: agent-default-model # magpie
  config:
    provider: magpie
    model: workbuddy-ai/deepseek-v4.1-flash-sg
    reasoningEffort: high
- id: ui-settings-account
  name: "@deepseek-ai/dsh-client-ui-settings-account"
  config:
    version: 1
    step: done
    purpose: development
    process: detailed
    completion: completed
    usage: detailed
    developerTools: true
- id: ui-chat
  name: "@deepseek-ai/dsh-client-ui-chat"
  config:
    transcriptView: verbose
    performanceUsage: detailed
- id: ui-settings
  name: "@deepseek-ai/dsh-client-ui-settings"
  config:
    enabled: true
- id: agent-preset-registry
  name: "@deepseek-ai/dsh-agent-preset-registry"
  config:
    default: standard
    selectedDefault: cordis
- id: session-log-deepseek
  name: "@deepseek-ai/dsh-session-log-deepseek"
  config:
    enabled: false
- id: plugin-market
  name: "@deepseek-ai/dsh-plugin-market"
  config:
    indexes:
      - https://kingcharleslzy-ai.github.io/dsh-purge/index.json
- insert:
    - id: cc-switch-mcp-node_repl
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        startup_timeout_sec: 120
        serverName: node_repl
        command: /Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node_repl
        env:
          BROWSER_USE_AVAILABLE_BACKENDS: chrome,iab
          BROWSER_USE_CODEX_APP_BUILD_FLAVOR: prod
          BROWSER_USE_CODEX_APP_VERSION: 26.924.22138
          BROWSER_USE_TINYSKY_ENABLED: '1'
          CODEX_CLI_PATH: /Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex
          CODEX_HOME: /Users/wheming/.codex
          NODE_REPL_INSTRUCTIONS_USE_CASE_BROWSER: ''
          NODE_REPL_INSTRUCTIONS_USE_CASE_CHROME: ''
          NODE_REPL_NATIVE_PIPE_CONNECT_TIMEOUT_MS: '1000'
          NODE_REPL_NODE_MODULE_DIRS: /Applications/ChatGPT.app/Contents/Resources/cua_node/lib/node_modules
          NODE_REPL_NODE_PATH: /Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node
          NODE_REPL_TRUSTED_CODE_PATHS: /Users/wheming/.codex:/Applications/ChatGPT.app/Contents/Resources/cua_node/lib/node_modules
          NODE_REPL_TRUSTED_SERVICES: '{"browser":"/Users/wheming/.codex/plugins/cache/openai-bundled/browser/26.924.22138/scripts/browser-service.mjs"}'
        transport: stdio
- insert:
    # magpie
    - id: magpie-mcp-magpie
      name: "@deepseek-ai/dsh-mcp-client"
      config:
        serverName: "magpie"
        transport: "streamable-http"
        url: "http://127.0.0.1:3425/mcp/magpie/hub/dsh"
- id: llm-pi-ai # magpie
  name: "@deepseek-ai/dsh-llm-pi-ai"
  config:
    providers:
      magpie:
        displayName: Magpie
        apiKeyEnv: MAGPIE_GATEWAY_KEY
        api: openai-completions
        baseURL: http://127.0.0.1:3425/v1
        models:
          - id: codearts/glm-5.3
            name: GLM-5.3 · CodeArts
            contextWindow: 1000000
            maxTokens: 128000
            input: [text, image]
            reasoningEfforts:
              "off": none
              low: low
              medium: medium
              high: high
              xhigh: xhigh
              max: max
          - id: codearts/glm-5.3-flash
            name: GLM-5.3-Flash · CodeArts
            contextWindow: 1000000
            maxTokens: 128000
            input: [text, image]
          - id: codearts/deepseek-v4.1-flash
            name: DeepSeek-V4.1-Flash · CodeArts
            contextWindow: 1000000
            maxTokens: 128000
            input: [text, image]
          - id: codearts/kimi-k3.1-pro
            name: Kimi-K3.1-Pro · CodeArts
            contextWindow: 1000000
            maxTokens: 128000
            input: [text, image]
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
              max: max
          - id: workbuddy-ai/hy4flash-free
            name: Hy4 flash (FREE) · WorkBuddy AI
            contextWindow: 960000
            maxTokens: 128000
            input: [text, image]
            reasoningEfforts:
